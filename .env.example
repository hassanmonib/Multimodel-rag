# ─────────────────────────────────────────────────────────────────────────────
# Multimodal RAG Search – Environment Configuration
# Copy this file to .env and fill in real values
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL:
DATABASE_URL=postgresql://user:password@localhost:5432/multimodal_rag
# SQLite fallback (comment-out above and uncomment below for local dev):
# DATABASE_URL=sqlite:///./multimodal_rag.db

# ── Qdrant Vector DB ─────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
# For Qdrant Cloud, set QDRANT_URL and QDRANT_API_KEY instead:
# QDRANT_URL=https://xyz.qdrant.tech
# QDRANT_API_KEY=your-qdrant-api-key

# Collection names
QDRANT_VIDEO_COLLECTION=video_chunks
QDRANT_PDF_COLLECTION=pdf_chunks

# ── OpenAI (LLM for RAG) ─────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# For Ollama / other OpenAI-compatible APIs:
# OPENAI_BASE_URL=http://localhost:11434/v1

# ── HuggingFace (for pyannote.audio diarization) ─────────────────────────────
# Only needed if using Whisper + pyannote (no Deepgram).
HUGGINGFACE_TOKEN=hf_...

# ── Deepgram (transcription + diarization) ───────────────────────────────────
# If set, YouTube ingestion uses Deepgram instead of Whisper + pyannote.
# No HuggingFace token needed when using Deepgram.
# DEEPGRAM_API_KEY=your-deepgram-api-key
# DEEPGRAM_MODEL=nova-2

# ── Text Embedding Model ──────────────────────────────────────────────────────
TEXT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── CLIP Image Embedding Model ────────────────────────────────────────────────
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=openai

# ── BLIP Caption Model ────────────────────────────────────────────────────────
CAPTION_MODEL=Salesforce/blip-image-captioning-base

# ── Whisper (ASR) ─────────────────────────────────────────────────────────────
WHISPER_MODEL_SIZE=base

# ── Storage Paths ─────────────────────────────────────────────────────────────
STORAGE_DIR=./storage
VIDEO_FRAMES_DIR=./storage/frames
PDF_IMAGES_DIR=./storage/pdf_images

# ── Tesseract Binary (Windows) ────────────────────────────────────────────────
# Uncomment and set path if tesseract is not on PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ── Retrieval ─────────────────────────────────────────────────────────────────
DEFAULT_TOP_K=5
DEFAULT_CONFIDENCE_THRESHOLD=0.3

# ── Offline mode (Hugging Face) ───────────────────────────────────────────────
# Set to 1 to use only cached models (no download). Run once with internet first.
# HF_HUB_OFFLINE=1

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
